{
  "rules": {
    ".read": false,
    ".write": false,
    "streamerMessenger": {
      "publicRooms": {
        ".read": "auth != null",
        ".write": false,
        ".indexOn": [
          "streamerNickname",
          "visibility"
        ]
      },
      "rooms": {
        "$roomId": {
          "meta": {
            ".read": "auth != null && (root.child('streamerMessenger').child('rooms').child($roomId).child('meta').child('ownerUid').val() === auth.uid || root.child('streamerMessenger').child('rooms').child($roomId).child('members').child(auth.uid).child('status').val() === 'active')",
            ".write": false
          },
          "members": {
            "$uid": {
              ".read": "auth != null && (auth.uid === $uid || root.child('streamerMessenger').child('rooms').child($roomId).child('meta').child('ownerUid').val() === auth.uid)",
              ".write": false
            }
          },
          "applications": {
            ".read": "auth != null && root.child('streamerMessenger').child('rooms').child($roomId).child('meta').child('ownerUid').val() === auth.uid",
            "$uid": {
              ".read": "auth != null && (auth.uid === $uid || root.child('streamerMessenger').child('rooms').child($roomId).child('meta').child('ownerUid').val() === auth.uid)",
              ".write": false
            }
          },
          "blocked": {
            "$uid": {
              ".read": "auth != null && (auth.uid === $uid || root.child('streamerMessenger').child('rooms').child($roomId).child('meta').child('ownerUid').val() === auth.uid)",
              ".write": false
            }
          }
        }
      },
      "roomMarkets": {
        ".read": false,
        ".write": false,
        "$roomId": {
          ".read": "auth != null && (root.child('streamerMessenger').child('rooms').child($roomId).child('meta').child('ownerUid').val() === auth.uid || root.child('streamerMessenger').child('rooms').child($roomId).child('members').child(auth.uid).child('status').val() === 'active')",
          ".write": false
        }
      },
      "chat": {
        "$roomId": {
          "streamerTimeline": {
            ".read": "auth != null && root.child('streamerMessenger').child('rooms').child($roomId).child('meta').child('ownerUid').val() === auth.uid",
            ".write": false,
            ".indexOn": [
              "createdAt"
            ],
            "$messageId": {
              ".write": false
            }
          },
          "broadcast": {
            ".read": "auth != null && (root.child('streamerMessenger').child('rooms').child($roomId).child('meta').child('ownerUid').val() === auth.uid || root.child('streamerMessenger').child('rooms').child($roomId).child('members').child(auth.uid).child('status').val() === 'active')",
            ".write": false,
            ".indexOn": [
              "createdAt"
            ],
            "$messageId": {
              ".write": false
            }
          },
          "private": {
            "$uid": {
              ".read": "auth != null && (auth.uid === $uid && root.child('streamerMessenger').child('rooms').child($roomId).child('members').child(auth.uid).child('status').val() === 'active' || root.child('streamerMessenger').child('rooms').child($roomId).child('meta').child('ownerUid').val() === auth.uid)",
              ".write": false,
              ".indexOn": [
                "createdAt"
              ],
              "$messageId": {
                ".write": false
              }
            }
          }
        }
      },
      "reports": {
        ".read": false,
        ".write": false,
        ".indexOn": [
          "createdAt",
          "roomId",
          "status"
        ],
        "$reportId": {
          ".write": false
        }
      },
      "reportEvidence": {
        ".read": false,
        ".write": false,
        "$reportId": {
          ".write": false
        }
      },
      "auditLog": {
        ".read": false,
        ".write": false,
        ".indexOn": [
          "at"
        ],
        "$entryId": {
          ".write": false
        }
      },
      "rateLimits": {
        ".read": false,
        ".write": false
      },
      "admin": {
        ".read": false,
        ".write": false
      }
    },
    "presence": {
      "streamerMessenger": {
        ".read": false,
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || (newData.hasChildren(['lastSeen']) && newData.child('lastSeen').isNumber())",
          "lastSeen": {
            ".validate": "newData.isNumber()"
          },
          "connectedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "analytics": {
      "presenceHourly": {
        "streamerMessenger": {
          ".read": false,
          ".write": false
        }
      }
    }
  }
}
